"," ",["$","a",null,{"href":"tel:+79215211410","children":"+7 921 521-14-10"}]," либо сообщением в"," ",["$","a",null,{"href":"https://vk.ru/kelosevernyidom","children":"сообщество ВКонтакте"}],". Отзыв не влияет на законность обработки, выполненной до его получения."]}],["$","p",null,{"children":["Подробные условия описаны в"," ",["$","$Lb",null,{"href":"/srubkelo-preview/privacy","children":"политике обработки персональных данных"}],"."]}]],["$","p",null,{"className":"legal-updated","children":"Редакция от 5 сентября 2026 года"}]]}],["$","footer",null,{"className":"legal-footer","children":["ИП Ширма Виталий Валерьевич · ИНН 101700736760 ·"," ",["$","a",null,{"href":"tel:+79215211410","children":"+7 921 521-14-10"}]]}]]}]
