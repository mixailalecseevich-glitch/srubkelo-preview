10:["$","p",null,{"children":["Пользователь вправе запросить сведения об обработке, потребовать уточнения, блокирования или удаления данных, а также отозвать согласие. Обратиться можно по телефону"," ",["$","a",null,{"href":"tel:+79215211410","children":"+7 921 521-14-10"}]," или через"," ",["$","a",null,{"href":"https://vk.ru/kelosevernyidom","children":"сообщество ВКонтакте"}],"."]}]
