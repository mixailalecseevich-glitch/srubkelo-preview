3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Политика обработки персональных данных — Kelo Северный Дом"}],["$","meta","1",{"name":"description","content":"Дома, бани и срубы из карельской сухостойной сосны кело. Более 20 объектов, реальные работы и личная консультация Виталия."}],["$","meta","2",{"name":"keywords","content":"дом из кело,баня из кело,сруб из кело,карельская сухостойная сосна,строительство из кело"}],["$","meta","3",{"name":"robots","content":"noindex, nofollow"}],["$","meta","4",{"property":"og:title","content":"Kelo Северный Дом"}],["$","meta","5",{"property":"og:description","content":"Дома и бани из карельского кело с доставкой и сборкой."}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"property":"og:locale","content":"ru_RU"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"Kelo Северный Дом"}],["$","meta","10",{"name":"twitter:description","content":"Дома и бани из карельского кело с доставкой и сборкой."}],["$","link","11",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/icon.svg?25eff4631135cdff","type":"image/svg+xml","sizes":"any","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["privacy"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"privacy","fallback":["$","main",null,{"className":"not-found","children":[["$","span",null,{"children":"404"}],["$","h1",null,{"children":"Такой страницы нет"}],["$","p",null,{"children":"Вернитесь на главную, чтобы посмотреть проекты и связаться с Виталием."}],["$","$Lb",null,{"className":"button button-primary","href":"/","children":"На главн